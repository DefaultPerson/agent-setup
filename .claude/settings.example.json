{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
      "hooks": [{
        "type": "command",
        "command": "uv run --no-project \"$HOME/.claude/hooks/guard.py\"",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --no-project \"$HOME/.claude/hooks/notification.py\" --notify",
        "timeout": 15
      }]
    }],
    "Notification": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --no-project \"$HOME/.claude/hooks/notification.py\" --permission",
        "timeout": 15
      }]
    }]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run --no-project \"$HOME/.claude/hooks/statusline.py\"",
    "padding": 0,
    "refreshInterval": 60
  },
  "env": {
    "DESKTOP_NOTIFICATIONS": "1",
    "GUARD_PROTECTED_UNITS": ""
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
